# ---------------------------------------------------------------------------
# RoundTwo — environment configuration
# Copy to .env.local for development, or paste into your host's env settings.
# The site renders correctly with none of these set; lead delivery does not.
#
# NEXT_PUBLIC_* values are baked in when `next build` runs, because the pages
# are statically prerendered. Set them before building and rebuild after any
# change. Everything else is read per request and needs no rebuild.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# Canonical origin. Used for metadataBase, canonical URLs, sitemap and robots.
# Set this before launch or Open Graph links will point at the placeholder.
NEXT_PUBLIC_SITE_URL=https://roundtwo.com


# --- Lead delivery (REQUIRED — at least one of the two blocks below) --------
# Without a destination the API returns an error in production and the form
# shows a "email us instead" fallback. It never fakes a successful submission.

# 1) Webhook. Server-side only, never exposed to the browser. Point it at
#    n8n, Zapier, Make, a CRM endpoint, a Google Sheets bridge — anything that
#    accepts JSON. Payload: { "type": "lead.created", "lead": { ... } }
LEAD_WEBHOOK_URL=

# Optional. Sent as the `x-roundtwo-secret` header so your automation can
# verify the request really came from this site.
LEAD_WEBHOOK_SECRET=

# 2) Email notification via Resend (https://resend.com). Both values needed.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=you@yourdomain.com
# Optional. Must be a domain you have verified in Resend.
# Defaults to Resend's shared testing sender when unset.
RESEND_FROM_EMAIL=RoundTwo <hello@yourdomain.com>


# --- Booking handoff (optional) --------------------------------------------
# When set, the form's success screen offers "Book a 15-minute call".
NEXT_PUBLIC_BOOKING_URL=


# --- Analytics (all optional) ----------------------------------------------
# Any that are left blank simply do not load. No script, no cookie.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# --- Friction Company (/friction) -------------------------------------------
# A separate brand sharing this deployment. Its intake posts here instead of
# the lead webhook above, so the two never land in the same pile. If only
# LEAD_WEBHOOK_URL is set, Friction falls back to it.
FRICTION_WEBHOOK_URL=
FRICTION_WEBHOOK_SECRET=
